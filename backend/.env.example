APP_NAME=Bisheng Gateway
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
DB_AUTO_CREATE=true
DB_REQUIRED=false
JWT_ALGORITHM=HS256
# Base64 of at least 32 random bytes. Example generation:
# openssl rand -base64 48
JWT_SECRET_KEY=
# RS256 only: PEM content or a deployment-specific multiline environment value.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=bisheng-gateway
JWT_AUDIENCE=bisheng-client
EXTERNAL_API_URL=http://localhost:8080
EXTERNAL_API_KEY=
UPSTREAM_BEARER_TOKEN=
SAFETY_FILTER_ENABLED=false
SAFETY_BASE_URL=
SAFETY_APPKEY=
SAFETY_SECRET_KEY=
SAFETY_TEMPLATE_ID=
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400
REDIS_MAX_CONNECTIONS=50
